# AdaptiveVision environment (example). Copy to `.env` for local use.
#
# Configuration is loaded and validated in Milestone M2 by
# adaptivevision.config.load_config. Existing environment variables take
# precedence over values in this file.

# Station identity
ADAPTIVEVISION_STATION_ID=station-01

# Root logging level (INFO, DEBUG, WARNING, ERROR)
ADAPTIVEVISION_LOG_LEVEL=INFO

# Recipe to load at startup (optional). Configures the anomaly threshold and
# decision policy (see recipes/*.json); without one the station still runs
# but every part passes unconditionally, same as before M9/M10 were wired in.
ADAPTIVEVISION_DEFAULT_RECIPE_ID=demo-bottle
ADAPTIVEVISION_RECIPE_DIR=recipes

# Preferred ONNX Runtime execution provider (tensorrt, cuda, openvino, cpu)
ADAPTIVEVISION_EXECUTION_PROVIDER=cpu

# ONNX model for the M9 anomaly detector (optional; relative to MODEL_DIR
# unless absolute). Without this the pipeline skips anomaly detection
# entirely, same as calibration/alignment when their paths are unset.
# The null camera used without real hardware only ever produces a blank
# grayscale frame, so the skeleton default is a grayscale-input model
# (mvtec_bottle.onnx, 128x128) purely to prove real inference runs
# end-to-end with zero hardware. A real camera driver (or DEMO_IMAGE_PATH
# below) + the far more accurate patchcore_dinov2_vitb14__mvtec_bottle.onnx
# (RGB, 256x256, from the training sweep) is what tests/e2e/test_e2e.py
# exercises for a real good-vs-defective proof.
ADAPTIVEVISION_MODEL_PATH=mvtec_bottle.onnx
ADAPTIVEVISION_MODEL_DIR=models
ADAPTIVEVISION_MODEL_INPUT_HEIGHT=128
ADAPTIVEVISION_MODEL_INPUT_WIDTH=128

# To demo the real RGB model instead of the tiny grayscale one above:
# ADAPTIVEVISION_MODEL_PATH=patchcore_dinov2_vitb14__mvtec_bottle.onnx
# ADAPTIVEVISION_MODEL_INPUT_HEIGHT=256
# ADAPTIVEVISION_MODEL_INPUT_WIDTH=256
# ADAPTIVEVISION_PREPROCESS_GRAYSCALE=False
#
# Replay one real image file instead of the null camera's blank frame (see
# adaptivevision.camera.FileImageCameraDriver) -- needed for the RGB model
# above, since a blank frame has no real anomaly signal to detect:
# ADAPTIVEVISION_DEMO_IMAGE_PATH=/path/to/mvtec/bottle/test/good/000.png

# Maximum allowed inspection cycle time in milliseconds
ADAPTIVEVISION_CYCLE_TIMEOUT_MS=5000.0

# Comma-separated list of camera ids (optional at M2)
# ADAPTIVEVISION_CAMERA_IDS=cam0,cam1
# Per-camera settings use ADAPTIVEVISION_CAMERA_<ID>_* (id uppercased):
# ADAPTIVEVISION_CAMERA_CAM0_KIND=area_scan_2d
# ADAPTIVEVISION_CAMERA_CAM0_WIDTH=640
# ADAPTIVEVISION_CAMERA_CAM0_HEIGHT=480
# ADAPTIVEVISION_CAMERA_CAM0_FPS=30.0
# ADAPTIVEVISION_CAMERA_CAM0_DEVICE=0
