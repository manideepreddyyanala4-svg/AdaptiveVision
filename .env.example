# AdaptiveVision runtime configuration. Copy to `.env` for local use.
#
# Every value here is read by adaptivevision.config.load_config(). Real
# environment variables take precedence over this file. All ADAPTIVEVISION_*
# keys are optional; with none of them set the station still boots and runs a
# walking-skeleton inspection (null camera, no model, every part passes).

# --- Station identity / logging -------------------------------------------
ADAPTIVEVISION_STATION_ID=station-01
ADAPTIVEVISION_LOG_LEVEL=INFO

# --- Recipe (anomaly threshold + decision policy; see recipes/*.json) ----
ADAPTIVEVISION_DEFAULT_RECIPE_ID=demo-bottle
ADAPTIVEVISION_RECIPE_DIR=recipes

# --- ONNX anomaly model (optional) --------------------------------------
# Without a model path the anomaly stage is skipped entirely.
# MODEL_PATH is resolved relative to MODEL_DIR unless it is absolute.
# The model .onnx files are not in this repository (~14 GB); export one with
#   python -m training.export export --method patchcore_dinov2_vitb14 --dataset mvtec/bottle
ADAPTIVEVISION_EXECUTION_PROVIDER=cpu
ADAPTIVEVISION_MODEL_DIR=models
ADAPTIVEVISION_MODEL_PATH=patchcore_dinov2_vitb14__mvtec_bottle.onnx
ADAPTIVEVISION_MODEL_INPUT_HEIGHT=256
ADAPTIVEVISION_MODEL_INPUT_WIDTH=256
ADAPTIVEVISION_PREPROCESS_GRAYSCALE=False

# Replay one real image instead of the null camera's blank frame. Set this to
# a good sample for a PASS, or a defective one for a FAIL.
# ADAPTIVEVISION_DEMO_IMAGE_PATH=/path/to/mvtec/bottle/test/good/000.png

# --- Defect localization / metrology (optional) ------------------------
# Needs a normal-patch bank built by scripts/build_patch_bank.py.
# ADAPTIVEVISION_METROLOGY_ENABLED=true
# ADAPTIVEVISION_PATCH_BANK_PATH=models/patchcore_dinov2_vitb14__mvtec_bottle.bank.npz

# --- Persistence / image archive -------------------------------------
ADAPTIVEVISION_DB_PATH=adaptivevision.db
ADAPTIVEVISION_IMAGE_STORE_DIR=images

# --- Optional PLC reject dispatch (Modbus TCP) ---------------------
# Unset by default. scripts/mock_plc.py is a local simulator on port 5020.
# ADAPTIVEVISION_PLC_HOST=127.0.0.1
# ADAPTIVEVISION_PLC_PORT=5020
# ADAPTIVEVISION_PLC_REJECT_COIL=3

# --- Optional local-LLM advisory (Ollama) ------------------------
# Requires a running Ollama server with the model pulled:
#   ollama serve ; ollama pull qwen2.5:7b
# ADAPTIVEVISION_ADVISORY_ENABLED=true
# ADAPTIVEVISION_OLLAMA_MODEL=qwen2.5:7b
# ADAPTIVEVISION_OLLAMA_HOST=http://127.0.0.1:11434
# ADAPTIVEVISION_OLLAMA_TIMEOUT_S=90

# --- Misc --------------------------------------------------------
ADAPTIVEVISION_CYCLE_TIMEOUT_MS=5000.0
# ADAPTIVEVISION_LOT_ID=LOT-0001
# ADAPTIVEVISION_PRODUCT_CATEGORY=bottle

# --- Cameras (optional; comma-separated ids, then per-id settings) --
# ADAPTIVEVISION_CAMERA_IDS=cam0
# ADAPTIVEVISION_CAMERA_CAM0_KIND=area_scan_2d
# ADAPTIVEVISION_CAMERA_CAM0_WIDTH=640
# ADAPTIVEVISION_CAMERA_CAM0_HEIGHT=480
# ADAPTIVEVISION_CAMERA_CAM0_FPS=30.0
